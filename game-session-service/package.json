{
  "name": "game-session-service",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env frontend/dev.ts",
    "dev:api": "node --env-file-if-exists=.env --watch backend/server.ts",
    "account:create": "node --env-file-if-exists=.env backend/features/auth/controller/create-account.ts",
    "account:password": "node --env-file-if-exists=.env backend/features/auth/controller/change-password.ts",
    "build": "npm run check && npm run build --workspace frontend",
    "check": "tsc --noEmit -p backend && tsc --noEmit -p frontend",
    "test": "node --test backend/auth.test.ts backend/runner.test.ts backend/features/agent/controller/http.test.ts backend/features/lobbies/services/lobbies.test.ts",
    "start:api": "node --env-file-if-exists=.env backend/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@inquirer/password": "^4.0.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "1.0.0-rc.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.0",
    "@types/passport-local": "^1.0.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "1.0.0-rc.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "node": ">=24.2 <25"
  }
}
