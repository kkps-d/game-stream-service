      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "game-stream-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 7,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
