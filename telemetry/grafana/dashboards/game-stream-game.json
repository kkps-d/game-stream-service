    {
      "id": 5,
      "title": "CPU and memory limit usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "game-stream-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 7,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(game_stream_cpu_seconds_total{game=~\"$game\",game_instance=~\"$game_instance\"}[5s]) / game_stream_cpu_logical_allowed{game=~\"$game\",game_instance=~\"$game_instance\"}",
          "legendFormat": "CPU set used",
          "datasource": {
            "type": "prometheus",
            "uid": "game-stream-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "100 * game_stream_memory_bytes{game=~\"$game\",game_instance=~\"$game_instance\"} / game_stream_memory_limit_bytes{game=~\"$game\",game_instance=~\"$game_instance\"}",
          "legendFormat": "RAM limit used",
          "datasource": {
            "type": "prometheus",
            "uid": "game-stream-prometheus"
          }
        }
      ]
    },
    {
