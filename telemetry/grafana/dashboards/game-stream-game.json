        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(time() - game_stream_last_frame_timestamp_seconds{game=~\"$game\",game_instance=~\"$game_instance\"}, 0)",
          "legendFormat": "Age",
          "datasource": {
            "type": "prometheus",
            "uid": "game-stream-prometheus"
          }
        }
      ]
